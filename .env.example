# Optional. Copy to .env at the repository root; npm run dev reads it.
API_ADDR=127.0.0.1:3000
# Server-side Vite proxy target. Keep this aligned with API_ADDR.
API_PROXY_TARGET=http://127.0.0.1:3000

# Default run.sh starts local Compose PostgreSQL. Choose a password first.
# Local mode derives REPORT_POSTGRES_DSN in memory; external mode uses it directly.
# REPORT_POSTGRES_WAIT_SECONDS=60
# Keep actual values only in your untracked .env. Use URL-encoding in the DSN
# if the password contains URI-reserved characters.
# REPORT_POSTGRES_PASSWORD=replace-with-a-local-password
# REPORT_POSTGRES_DSN=postgres://watermill_demo:replace-with-a-local-password@127.0.0.1:54329/watermill_demo?sslmode=disable
# Integration tests opt in separately; use a dedicated test/demo database only.
# TEST_REPORT_POSTGRES_DSN=postgres://watermill_demo:replace-with-a-local-password@127.0.0.1:54329/watermill_demo?sslmode=disable
